meta {
  name: 11 Invité - Miniature (option asynchrone)
  type: http
  seq: 11
}

docs {
  La miniature est calculée en arrière-plan après le dépôt.
  Tant qu'elle n'est pas prête, la route renvoie l'original.
}

get {
  url: {{baseUrl}}/api/guest/media/{{mediaId}}/thumbnail
  body: none
  auth: none
}

headers {
  X-Guest-Token: {{guestToken}}
}

assert {
  res.status: eq 200
}

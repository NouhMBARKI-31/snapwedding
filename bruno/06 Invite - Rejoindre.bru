meta {
  name: 06 Invité - Rejoindre avec un pseudo
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/public/events/{{publicCode}}/join
  body: json
  auth: none
}

body:json {
  {
    "pseudo": "Tonton Paul"
  }
}

script:post-response {
  bru.setVar("guestToken", res.body.token);
}

assert {
  res.status: eq 201
  res.body.token: isString
}

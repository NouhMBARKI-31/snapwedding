@startuml
title <size:24>Admin</size>

set separator none
top to bottom direction

<style>
  root {
    BackgroundColor: #ffffff
    FontColor: #444444
  }
</style>

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Component>

System_Boundary("SnapWeddingApplication_boundary", "SnapWeddingApplication", $tags="") {
  Container_Boundary("SnapWeddingApplication.SnapWeddingApplication_boundary", "SnapWeddingApplication", $tags="") {
    Component(SnapWeddingApplication.SnapWeddingApplication.Event, "Event", $techn="Module", $descr="", $tags="", $link="")
    Component(SnapWeddingApplication.SnapWeddingApplication.Media, "Media", $techn="Module", $descr="", $tags="", $link="")
    Component(SnapWeddingApplication.SnapWeddingApplication.Admin, "Admin", $techn="Module", $descr="", $tags="", $link="")
  }

}

Rel(SnapWeddingApplication.SnapWeddingApplication.Media, SnapWeddingApplication.SnapWeddingApplication.Event, "listens to", $techn="", $tags="", $link="")
Rel(SnapWeddingApplication.SnapWeddingApplication.Media, SnapWeddingApplication.SnapWeddingApplication.Event, "uses", $techn="", $tags="", $link="")
Rel(SnapWeddingApplication.SnapWeddingApplication.Admin, SnapWeddingApplication.SnapWeddingApplication.Event, "uses", $techn="", $tags="", $link="")
Rel(SnapWeddingApplication.SnapWeddingApplication.Admin, SnapWeddingApplication.SnapWeddingApplication.Media, "uses", $techn="", $tags="", $link="")

SHOW_LEGEND(true)
hide stereotypes
@enduml